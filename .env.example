# Copy to .env.local and fill in values.
# https://console.cloud.google.com/apis/credentials — OAuth 2.0 Client (Web application)
# Authorized redirect URIs (must match EXACTLY — Error 400 redirect_uri_mismatch otherwise):
#   http://localhost:3000/api/auth/callback/google
# If you open the app at http://127.0.0.1:3000, also add:
#   http://127.0.0.1:3000/api/auth/callback/google
# Production: https://YOUR_DOMAIN/api/auth/callback/google

AUTH_SECRET=
# Required in production. Local dev uses a temporary built-in secret until you set this.

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# You (the deployer) create these once in Google Cloud → APIs & Services → Credentials
# (OAuth client ID, type “Web application”). End users never paste secrets—they only
# click “Sign in with Google” on your site.
#
# So *any* Google account can use the app: in Cloud Console → OAuth consent screen,
# use User type “External”, then when ready move the app out of “Testing” (publish /
# production). While in Testing, only emails you add under “Test users” can sign in.

# Vercel / reverse proxy (recommended in production)
# AUTH_TRUST_HOST=true

# Optional; inferred on Vercel. For local dev:
# AUTH_URL=http://localhost:3000

# --- Database (PostgreSQL — production) ---
# Required for Google sign-in (Prisma adapter stores users) AND for saved chats.
#
# Production / Vercel: set `DATABASE_URL` in project env and use build command:
#   npm run build:production
# so migrations apply before `next build`. (Plain `npm run build` skips migrate so
# local builds work without a running database.)
#
# Local: start Postgres, migrate, restart dev:
#   npm run db:up
#   npm run db:migrate
#   npm run dev
#
# Then set in `.env.local` (host port 5433 avoids clashing with a local Postgres on 5432):
DATABASE_URL=

#
# Troubleshooting `npm run db:up` / `npm run db:migrate`:
# - "Cannot connect to the Docker daemon" → open Docker Desktop and wait until it is
#   fully running, then run `npm run db:up` again.
# - Prisma `P1010` / "denied access" on localhost:5432 → usually nothing is listening
#   (Docker Postgres not up) OR another Postgres on your Mac is using port 5432 with a
#   different password. Fix: start Docker + `db:up`, or change the host port in
#   docker-compose.yml (e.g. "5433:5432") and set DATABASE_URL port to 5433.
#
# No Docker? Use free hosted Postgres (e.g. https://neon.tech ): create a project, copy
# the connection string (include `?sslmode=require`), put it in `.env.local` as
# DATABASE_URL, then `npm run db:migrate` (no `db:up`).
#
# Neon-only (without changing `.env.local`): create `.env.neon` with one line
#   DATABASE_URL="postgresql://...neon...?sslmode=require..."
# (`.env.neon` is gitignored.) Then run:  npm run db:migrate:neon
#
# Hosted (Neon / Supabase / RDS): paste the pooled connection string, usually with:
#   ?sslmode=require
# If `prisma migrate deploy` fails through a pooler, use the provider’s non-pooled “direct”
# URL for migrations only, or temporarily point DATABASE_URL at the direct URL for deploy.

# --- Voice pipeline: speech-to-text → LLM → text-to-speech ---
# Each stage is a separate provider, so any one of them can be swapped.

# 1. Speech-to-text — Deepgram (https://console.deepgram.com)
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=en

# 2. LLM brain — NVIDIA NIM, OpenAI-compatible (https://build.nvidia.com)
NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# LLM_MODEL=
# Point these at any other OpenAI-compatible provider to swap the brain:
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_API_KEY=

# 3. Text-to-speech — ElevenLabs (https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Anonymous pipeline in production (optional; quota risk)
# PIPELINE_ALLOW_ANON=true

# Force sign-in for pipeline even in local dev (optional)
# PIPELINE_REQUIRE_AUTH=true

# Voice on /session/voice uses Pipecat (Python). Local default is this URL.
# For a hosted backend (Railway, Fly, a VM), set the public HTTPS origin — no trailing slash.
# NEXT_PUBLIC_PIPECAT_BACKEND_URL=http://127.0.0.1:7860
