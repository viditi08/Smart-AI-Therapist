NVIDIA_API_KEY=
# Copy the exact dialogue model ID from your NVIDIA API Catalog endpoint.
NVIDIA_MODEL=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Create a LiveKit Cloud project and copy these values from Project Settings.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Origins must exactly match the frontend URLs that may create voice sessions.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Hosting services provide PORT automatically; local default is 7860.
PORT=7860
