# Recommended low-latency dialogue provider (Google Gemini Flash).
LLM_PROVIDER=google
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional comma-separated fallbacks when the primary model returns 503.
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Create a LiveKit Cloud project and copy these values from Project Settings.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Origins that may call /api/session directly. Vercel preview/production
# URLs are also allowed. The Next.js /api/voice/session proxy can send
# VOICE_BACKEND_SECRET instead of an Origin.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# VOICE_BACKEND_SECRET=
# Hosting services provide PORT automatically; local default is 7860.
PORT=7860
